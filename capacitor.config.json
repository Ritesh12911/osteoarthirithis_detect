{
  "appId": "com.jointsense.oa",
  "appName": "JointSense",
  "webDir": "dashboard",
  "server": {
    "url": "https://jointsense-jmkt.onrender.com",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "jointsense-jmkt.onrender.com",
      "*.onrender.com"
    ]
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    },
    "backgroundColor": "#030712",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#030712",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
